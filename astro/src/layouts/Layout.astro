---
import '../styles/global.css'
import SpeedInsights from '@vercel/speed-insights/astro'
import {ClientRouter} from 'astro:transitions'
import type {THEME_QUERY_RESULT} from '../../sanity.types'
import SanityLive from '../components/SanityLive.astro'
import ThemeButton from '../components/ThemeButton'

interface Props {
  title: string
  theme: NonNullable<THEME_QUERY_RESULT> | undefined
  tags: string[]
}

const {title, theme, tags} = Astro.props
---

<!doctype html>
<html
  lang="en"
  class="bg-theme text-theme transition-colors duration-1000 ease-in-out"
  style={{
    ['--theme-background' as string]: theme?.background,
    ['--theme-text' as string]: theme?.text,
  }}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <div class="relative flex min-h-dvh flex-col items-center justify-evenly overflow-auto">
      <slot />
      <ThemeButton client:load />
    </div>
    <SanityLive tags={tags} />
    <SpeedInsights />
  </body>
</html>
