---
import {getLiveEntry} from 'astro:content'
import {defineQuery} from 'groq'
import Reactions from '../components/Reactions'
import Layout from '../layouts/Layout.astro'

export const prerender = false

const INDEX_QUERY = defineQuery(
  `*[_type == "demo" && slug.current == $slug][0]{title,reactions[0..4]{_key,_ref}}`,
)
const slug = 'astro'
const {entry} = await getLiveEntry('sanity', {
  id: `demo-${slug}`,
  query: INDEX_QUERY,
  params: {slug},
})
const data = entry?.data as {title?: string; reactions?: {_key: string; _ref: string}[]} | undefined
const title = data?.title || 'Astro'
---

<Layout title={title}>
  <h1
    class="text-4xl leading-tight font-bold tracking-tighter text-balance md:text-6xl lg:pr-8 lg:text-8xl"
  >
    {title}
  </h1>
  {data?.reactions && <Reactions client:load data={data.reactions} />}
</Layout>
