---
import {getLiveEntry} from 'astro:content'
import Reactions from '../components/Reactions'
import Layout from '../layouts/Layout.astro'

const [theme, demo] = await Promise.all([
  getLiveEntry('theme', 'theme'),
  getLiveEntry('demo', 'astro'),
])
if (theme.error) throw theme.error
if (demo.error) throw demo.error

// The page is cached on the CDN, keyed by the sync tags of everything it rendered, until one of
// them is purged through `/api/revalidate-tags`. The TTL is only a backstop.
const tags = [
  ...new Set([...(theme.entry?.cacheHint?.tags ?? []), ...(demo.entry?.cacheHint?.tags ?? [])]),
]
Astro.cache.set({tags, maxAge: 60 * 60 * 24 * 365})

const title = demo.entry?.data.title || 'Astro'
---

<Layout title={title} theme={theme.entry?.data} tags={tags}>
  <h1
    class="text-4xl leading-tight font-bold tracking-tighter text-balance md:text-6xl lg:pr-8 lg:text-8xl"
  >
    {title}
  </h1>
  {demo.entry?.data.reactions && <Reactions client:load data={demo.entry.data.reactions} />}
</Layout>
