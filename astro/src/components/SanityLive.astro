---
import {invalidation, LIVE_EVENTS_URL} from '../sanity/live'

interface Props {
  tags: string[]
}

const {tags} = Astro.props
---

<sanity-live
  data-events-url={LIVE_EVENTS_URL.href}
  data-invalidation={invalidation}
  data-tags={tags.join(',')}></sanity-live>

<script>
  import {navigate} from 'astro:transitions/client'
  import type {Invalidation} from '../sanity/live'

  class SanityLive extends HTMLElement {
    #events: EventSource | null = null

    connectedCallback(): void {
      const {eventsUrl, tags = ''} = this.dataset
      const invalidation = this.dataset.invalidation as Invalidation
      if (!eventsUrl) return
      const own = tags.split(',')

      this.#events = new EventSource(eventsUrl)
      this.#events.addEventListener('message', async (event) => {
        const {tags: changed} = JSON.parse(event.data) as {tags: string[]}
        const overlap = changed.filter((tag) => own.includes(tag))
        if (overlap.length === 0) return

        switch (invalidation) {
          case 'function':
            break
          case 'browser':
            await fetch('/api/revalidate-tags', {
              method: 'POST',
              headers: {'content-type': 'application/json'},
              body: JSON.stringify({tags: overlap}),
            })
            break
          default:
            invalidation satisfies never
        }
        await navigate(window.location.href, {history: 'replace'})
      })
    }

    disconnectedCallback(): void {
      this.#events?.close()
      this.#events = null
    }
  }

  customElements.define('sanity-live', SanityLive)
</script>
