# Name of the studio's sync-tag invalidate Sanity Function once it POSTs to this deployment's
# /api/revalidate-tags. When set, or when VERCEL_ENV=production, the app caches Sanity queries in
# the Vercel Runtime Cache, tags the HTML and __data.json responses for the Vercel CDN, and the
# browser waits for the function to purge both before refreshing.
# Leave unset locally and on previews to bust the Sanity CDN per live event instead.
SANITY_SYNC_TAG_INVALIDATE_FUNCTION=cache-invalidate
